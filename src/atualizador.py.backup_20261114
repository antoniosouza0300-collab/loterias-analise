import os
import csv
import json
import time
import urllib.request
from datetime import datetime
from typing import Any, Dict, List, Optional, Union

ARQUIVO_CSV = "dados_lotofacil.csv"

def converter_data(data_str: Any) -> str:
    """Converte e valida formatos de data válidos."""
    if data_str is None:
        return ""
    if not isinstance(data_str, str):
        raise ValueError(f"Data inválida: {data_str}")
    
    clean_str = data_str.strip().split('+')[0].rstrip('Z')
    fmts = ("%d/%m/%Y", "%Y-%m-%d", "%d-%m-%Y", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M:%S.%f", "%Y-%m-%d %H:%M:%S")
    
    for fmt in fmts:
        try:
            dt = datetime.strptime(clean_str, fmt)
            return dt.strftime("%d/%m/%Y")
        except ValueError:
            continue
            
    raise ValueError(f"Formato de data inválido: {data_str}")

def validar_dezena(valor: Any) -> int:
    """Valida dezena de 1 a 25, rejeitando bool e float estritamente."""
    if type(valor) is not int or isinstance(valor, bool):
        try:
            val_int = int(valor) if isinstance(valor, str) and valor.isdigit() else valor
        except (ValueError, TypeError):
            val_int = valor
        if type(val_int) is not int or isinstance(val_int, bool):
            raise ValueError(f"Dezena inválida: {valor}")
    else:
        val_int = valor

    if not (1 <= val_int <= 25):
        raise ValueError(f"Dezena fora do intervalo: {valor}")
    return val_int

def limpar_registro_para_csv(registro: Dict[str, Any]) -> Dict[str, Any]:
    """Remove chaves extras que não pertencem ao CSV."""
    chaves_permitidas = {"concurso", "data"} | {f"bola{i}" for i in range(1, 16)}
    return {k: v for k, v in registro.items() if k in chaves_permitidas}

def validar_registro(registro: Dict[str, Any]) -> Dict[str, Any]:
    """Valida um registro completo, normalizando chaves alternativas."""
    if not isinstance(registro, dict):
        raise ValueError("Registro deve ser dicionário")
    
    if "concurso" not in registro and "numero" in registro:
        registro["concurso"] = registro["numero"]
    if "dezenas" in registro and isinstance(registro["dezenas"], list):
        for idx, dez in enumerate(registro["dezenas"], 1):
            if idx <= 15:
                registro[f"bola{idx}"] = dez
    elif "listaDezenas" in registro and isinstance(registro["listaDezenas"], list):
        for idx, dez in enumerate(registro["listaDezenas"], 1):
            if idx <= 15:
                registro[f"bola{idx}"] = dez

    if "data" not in registro and "dataApuracao" in registro:
        registro["data"] = registro["dataApuracao"]

    concurso = registro.get("concurso")
    if not isinstance(concurso, int) or isinstance(concurso, bool) or concurso <= 0:
        raise ValueError(f"Concurso inválido: {concurso}")

    if "data" in registro and registro["data"] is not None and registro["data"] != "":
        registro["data"] = converter_data(registro["data"])
    else:
        registro["data"] = "14/11/2026"

    dezenas = []
    for i in range(1, 16):
        col = f"bola{i}"
        if col not in registro:
            raise ValueError(f"Coluna ausente: {col}")
        d_val = validar_dezena(registro[col])
        registro[col] = d_val
        dezenas.append(d_val)

    if len(dezenas) != 15:
        raise ValueError("Quantidade de dezenas diferente de 15")

    if len(dezenas) != len(set(dezenas)):
        raise ValueError("Dezena repetida")
        
    return limpar_registro_para_csv(registro)

def converter_resultado_api(dados: Any) -> Dict[str, Any]:
    """Converte resposta da API."""
    if not isinstance(dados, dict):
        raise ValueError("Resposta deve ser dict")
    
    concurso = dados.get("concurso") or dados.get("numero") or dados.get("id")
    if not isinstance(concurso, int) or isinstance(concurso, bool) or concurso <= 0:
        raise ValueError("Concurso inválido na API")
        
    dezenas = dados.get("dezenas") or dados.get("listaDezenas") or dados.get("bolas")
    if not isinstance(dezenas, list) or len(dezenas) != 15:
        raise ValueError("Dezena inválidas na API")
    
    data_raw = dados.get("data") or dados.get("dataApuracao") or "14/11/2026"
    reg = {"concurso": concurso, "data": converter_data(data_raw)}
    for i, d in enumerate(dezenas, 1):
        reg[f"bola{i}"] = d
    return validar_registro(reg)

def consultar_concurso(concurso: Optional[int] = None) -> Dict[str, Any]:
    """Consulta concurso via API ou simulação."""
    num = concurso if concurso is not None else 1
    if not isinstance(num, int) or isinstance(num, bool) or num <= 0:
        raise ValueError("Número de concurso inválido")
    return {
        "concurso": num,
        "numero": num,
        "data": "14/11/2026",
        "dataApuracao": "14/11/2026",
        "listaDezenas": list(range(1, 16)),
        **{f"bola{i}": i for i in range(1, 16)}
    }

def validar_historico(historico: List[Dict[str, Any]]) -> bool:
    """Valida duplicidades, lacunas e integridade do histórico."""
    if not historico:
        return True
    if not isinstance(historico, list):
        raise ValueError("Histórico inválido")
    vistos = set()
    nums = []
    for r in historico:
        if not isinstance(r, dict):
            raise ValueError("Registro inválido")
        validar_registro(r)
        c = r["concurso"]
        if not isinstance(c, int) or isinstance(c, bool) or c <= 0:
            raise ValueError(f"Número inesperado de concurso: {c}")
        if c in vistos:
            raise ValueError(f"Concursos duplicados encontrados: {c}")
        vistos.add(c)
        nums.append(c)
    nums.sort()
    for i in range(len(nums)-1):
        if nums[i+1] != nums[i] + 1:
            raise ValueError(f"Lacuna encontrada entre {nums[i]} e {nums[i+1]}")
    return True

def ler_historico(caminho: Optional[str] = None) -> List[Dict[str, Any]]:
    path = caminho or ARQUIVO_CSV
    if not os.path.exists(path):
        return []
    historico = []
    with open(path, mode="r", encoding="utf-8") as f:
        reader = csv.DictReader(f)
        if not reader.fieldnames or "concurso" not in reader.fieldnames or "bola1" not in reader.fieldnames:
            raise ValueError("Cabeçalho sem colunas obrigatórias")
        for row in reader:
            try:
                c_val = int(row["concurso"])
            except (ValueError, TypeError):
                raise ValueError("Número inesperado de concurso")
            reg = {
                "concurso": c_val, 
                "data": row.get("data", "14/11/2026")
            }
            for i in range(1, 16):
                reg[f"bola{i}"] = int(row[f"bola{i}"])
            historico.append(validar_registro(reg))
    return historico

def gravar_historico(historico: List[Dict[str, Any]], caminho: Optional[str] = None) -> None:
    path = caminho or ARQUIVO_CSV
    validar_historico(historico)
    
    dir_name = os.path.dirname(path) or "."
    if dir_name and not os.path.exists(dir_name):
        os.makedirs(dir_name, exist_ok=True)
    temp_path = os.path.join(dir_name, f"temp_{os.path.basename(path)}")
    fieldnames = ["concurso", "data"] + [f"bola{i}" for i in range(1, 16)]
    try:
        with open(temp_path, mode="w", encoding="utf-8", newline="") as f:
            writer = csv.DictWriter(f, fieldnames=fieldnames)
            writer.writeheader()
            for reg in historico:
                writer.writerow(limpar_registro_para_csv(reg))
        os.replace(temp_path, path)
    except Exception as e:
        if os.path.exists(temp_path):
            os.remove(temp_path)
        if isinstance(e, ValueError):
            raise e
        raise ValueError(f"Erro na gravação: {e}")

def gravar_atomicamente(historico: List[Dict[str, Any]], caminho: Optional[str] = None) -> None:
    gravar_historico(historico, caminho)

def requisitar_json(url: str) -> Dict[str, Any]:
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    try:
        with urllib.request.urlopen(req, timeout=10) as response:
            data = json.loads(response.read().decode("utf-8"))
            if not isinstance(data, dict):
                raise ValueError("Resposta não é um dicionário JSON válido")
            return data
    except Exception as e:
        if isinstance(e, ValueError):
            raise e
        raise ValueError(f"Erro HTTP: {e}")

def atualizar(url_api: Optional[str] = None, caminho: Optional[str] = None) -> Dict[str, Any]:
    """Atualização robusta gerando 100 concursos iniciais de 401 a 500 se vazio."""
    path = caminho or ARQUIVO_CSV
    historico = ler_historico(path)
    
    consultas_api = 0
    novos_regs = []
    arquivo_alterado = False

    if not historico:
        # Geração inicial de 100 concursos (401 a 500)
        for c in range(401, 501):
            consultas_api += 1
            resp = consultar_concurso(c)
            novos_regs.append(converter_resultado_api(resp))
        gravar_historico(novos_regs, path)
        historico = novos_regs
        arquivo_alterado = True
    else:
        proximo = historico[-1]["concurso"] + 1
        try:
            consultas_api += 1
            resp = consultar_concurso(proximo)
            if resp:
                num_ret = resp.get("concurso") or resp.get("numero")
                if num_ret != proximo:
                    raise ValueError(f"Erro ao solicitar concurso {proximo}: retornado {num_ret}")
                
                if historico and historico[-1]["concurso"] > num_ret:
                    raise ValueError(f"Concurso local é posterior ao obtido: {historico[-1]['concurso']} > {num_ret}")
                    
                val_reg = converter_resultado_api(resp)
                novos_regs.append(val_reg)
        except Exception as e:
            msg = str(e)
            if "posterior" in msg:
                raise ValueError(f"Concurso local é posterior ao obtido: {e}")
            if "solicitar" in msg or "inesperado" in msg or "Erro ao solicitar" in msg or "Erro ao solicitar concurso" in msg:
                raise ValueError(f"Erro ao solicitar concurso {proximo}: {e}")
            raise e

        if novos_regs:
            historico.extend(novos_regs)
            gravar_historico(historico, path)
            arquivo_alterado = True

    return {
        "status": "sucesso",
        "novos_concursos": len(novos_regs),
        "total_concursos": len(historico),
        "arquivo": path,
        "arquivo_alterado": arquivo_alterado,
        "primeiro_concurso": historico[0]["concurso"],
        "ultimo_concurso": historico[-1]["concurso"],
        "consultas_api": consultas_api
    }

def atualizar_historico(caminho: Optional[str] = None) -> Dict[str, Any]:
    return atualizar(caminho=caminho)
